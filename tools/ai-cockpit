#!/usr/bin/env python3
# =============================================================
# ai-cockpit — AI開発コックピットへの状態送信CLI（担当H専任・2026-08-31）
#
# 使い方:
#   ai-cockpit start    --task TK-5 --agent 担当A --message "実装開始"
#   ai-cockpit progress --task TK-5 --percent 60 --message "PDF生成実装中"
#   ai-cockpit blocked  --task TK-5 --message "OAuth権限不足"
#   ai-cockpit done     --task TK-5 --message "実装・テスト完了"
#   ai-cockpit note     --message "メモ"           # 履歴に一行残す
#   ai-cockpit error    --task TK-5 --message "…"  # エラー報告（Larkにも通知される）
#   ai-cockpit list                                 # 未完了タスク一覧（TK番号の確認用）
#   ai-cockpit add --title "…" --agent 担当A [--priority high] [--desc "…"] [--status ready]
#                                                   # タスク登録（AIが新しい作業を積むとき）
#   ai-cockpit watch [--once]                       # 全リポジトリの作業を自動検知してhb送信
#                                                   # （常駐: LaunchAgent経由。--once=1回だけスキャン）
#
# 運用ルール: ユーザー（中山さん）が自分のタスクを済ませたと報告してきたら、
#   受けたセッションが list で番号を確認し done で代理完了する（本人に画面操作をさせない）
#   ai-cockpit hb                                   # heartbeatのみ（フック用・20秒間引き）
#   ai-cockpit idle                                 # セッションを待機に
#   ai-cockpit approval-request --task TK-5 --kind prod_deploy --message "本番デプロイの承認をください"
#   ai-cockpit approval-status  --task TK-5         # 承認されたか確認
#
# 設定: ~/.ns-cockpit/config（KEY=VALUE形式・リポジトリにコミットしない）
#   INGEST_URL=https://uuvsxzhpxtghojoubjcc.supabase.co/functions/v1/cockpit-ingest
#   TOKEN=（app_secretsのcockpit_ingest_tokenと同じ値）
#   DEVICE_KEY=macbook   （Mac miniなら mac-mini）
#
# 方針: 送信失敗・設定なしでも exit 0（開発作業を止めない）。git情報は自動採取。
# =============================================================
import datetime, json, os, sys, time, platform, socket, subprocess, urllib.request

CONF_DIR = os.path.expanduser("~/.ns-cockpit")
CONF_PATH = os.path.join(CONF_DIR, "config")
THROTTLE_PATH = os.path.join(CONF_DIR, "last_hb")
THROTTLE_SEC = 20

def read_conf():
    conf = {}
    try:
        with open(CONF_PATH) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    conf[k.strip()] = v.strip()
    except OSError:
        pass
    return conf

def sh(*args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return ""

def git_info():
    top = sh("git", "rev-parse", "--show-toplevel")
    if not top:
        return {}
    porcelain = sh("git", "status", "--porcelain")
    files = [l[3:].strip() for l in porcelain.splitlines() if len(l) > 3][:20]
    return {
        "repository": os.path.basename(top),
        "branch": sh("git", "rev-parse", "--abbrev-ref", "HEAD"),
        "git_head": sh("git", "rev-parse", "--short", "HEAD"),
        "changed_files_count": len(porcelain.splitlines()),
        "changed_files": files,
    }

# --- 定期ジョブ収集（watchが呼ぶ・すべて読み取り専用） -----------------
JOBS_SEEN_PATH = os.path.join(CONF_DIR, "jobs_seen.json")
JOB_WINDOW_H = 48  # 直近48時間ぶんだけ報告（初回の過去分洪水を防ぐ）

def jobs_seen_load():
    try:
        with open(JOBS_SEEN_PATH) as f:
            return json.load(f)
    except Exception:
        return {}

def jobs_seen_save(seen):
    try:
        if len(seen) > 3000:
            seen = dict(list(seen.items())[-1500:])
        with open(JOBS_SEEN_PATH, "w") as f:
            json.dump(seen, f)
    except OSError:
        pass

def collect_local_jobs(seen):
    """Mac miniの日次取込(ns-daily-import)の完了マーカー(.done-<task>-YYYYMMDD)を読む"""
    logs = os.path.expanduser("~/ns-daily-import/logs")
    if not os.path.isdir(logs):
        return []
    days = {(datetime.date.today() - datetime.timedelta(days=d)).strftime("%Y%m%d") for d in (0, 1)}
    runs = []
    for fn in os.listdir(logs):
        if not fn.startswith(".done-") or len(fn) < 16:
            continue
        task, date = fn[6:-9], fn[-8:]
        if date not in days or not task:
            continue
        key = f"mini:{task}:{date}"
        if key in seen:
            continue
        try:
            with open(os.path.join(logs, fn)) as f:
                info = json.load(f)
        except Exception:
            info = {}
        st = str(info.get("status", "成功"))
        runs.append({"run_key": key, "job": task, "source": "mac-mini",
                     "status": "success" if st.startswith("成功") else "failure",
                     "duration_sec": info.get("durationSec"), "at": info.get("at", ""),
                     "message": (info.get("error") or st)[:300]})
    return runs

def collect_gha(seen):
    """GitHub Actionsの完了済みワークフロー実行を gh api で読む（直近48hのみ）"""
    runs = []
    cutoff = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(hours=JOB_WINDOW_H)
    for repo in ("mirai-oss/ns-portal", "mirai-oss/tori-dashboard"):
        try:
            out = subprocess.run(["gh", "api", f"repos/{repo}/actions/runs?per_page=30&status=completed"],
                                 capture_output=True, text=True, timeout=30)
            if out.returncode != 0:
                continue
            data = json.loads(out.stdout)
        except Exception:
            continue
        for r in data.get("workflow_runs", []):
            key = f"gha:{r.get('id')}"
            if key in seen:
                continue
            started = r.get("run_started_at", "")
            try:
                t0 = datetime.datetime.fromisoformat(started.replace("Z", "+00:00"))
                if t0 < cutoff:
                    continue
                t1 = datetime.datetime.fromisoformat(str(r.get("updated_at")).replace("Z", "+00:00"))
                dur = max(0, int((t1 - t0).total_seconds()))
            except Exception:
                dur = None
            concl = r.get("conclusion") or ""
            status = "success" if concl == "success" else ("skipped" if concl in ("skipped", "cancelled", "neutral") else "failure")
            runs.append({"run_key": key, "job": r.get("name") or "workflow", "source": "github-actions",
                         "status": status, "duration_sec": dur, "at": started, "message": concl})
    return runs

def report_jobs(conf):
    seen = jobs_seen_load()
    runs = collect_local_jobs(seen) + collect_gha(seen)
    if not runs:
        return 0
    payload = {"token": conf["TOKEN"], "device_key": conf["DEVICE_KEY"], "job_runs": runs[:50]}
    req = urllib.request.Request(conf["INGEST_URL"], data=json.dumps(payload).encode("utf-8"),
                                 headers={"Content-Type": "application/json"}, method="POST")
    with urllib.request.urlopen(req, timeout=20) as res:
        res.read()
    for r in runs[:50]:
        seen[r["run_key"]] = 1
    jobs_seen_save(seen)
    return len(runs[:50])

def parse_args(argv):
    flags, i = {}, 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--"):
            if i + 1 < len(argv) and not argv[i + 1].startswith("--"):
                flags[a[2:]] = argv[i + 1]
                i += 2
            else:
                flags[a[2:]] = "1"
                i += 1
        else:
            i += 1
    return flags

CMDS = {
    "start":    dict(status="running", task_status="in_progress", event_type="task_start"),
    "progress": dict(status="running", event_type="progress"),
    "blocked":  dict(status="blocked", task_status="blocked", event_type="blocked"),
    "done":     dict(status="idle", task_status="done", event_type="task_done"),
    "note":     dict(event_type="note"),
    "error":    dict(event_type="error"),
    "list":     dict(),
    "add":      dict(),
    "update":   dict(),
    "watch":    dict(),
    "hb":       dict(status="running"),
    "idle":     dict(status="idle"),
    "approval-request": dict(status="waiting", event_type="approval_request"),
    "approval-status":  dict(),
}

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help") or sys.argv[1] not in CMDS:
        print(__doc__ or "使い方はスクリプト冒頭のコメント参照")
        print("コマンド: " + " / ".join(CMDS))
        return 0
    cmd = sys.argv[1]
    flags = parse_args(sys.argv[2:])
    conf = read_conf()
    if not conf.get("INGEST_URL") or not conf.get("TOKEN") or not conf.get("DEVICE_KEY"):
        # 未設定でも作業を止めない（手順書_コックピット_セットアップ_2026-08-31.md参照）
        if cmd != "hb":
            print("ai-cockpit: ~/.ns-cockpit/config が未設定のため送信をスキップしました", file=sys.stderr)
        return 0

    # 未完了タスク一覧（TK番号確認用・git情報等は送らない）。--all で完了含む全件
    if cmd == "list":
        req = urllib.request.Request(
            conf["INGEST_URL"],
            data=json.dumps({"token": conf["TOKEN"], "list_tasks": 1,
                             "include_done": 1 if "all" in flags else 0}).encode("utf-8"),
            headers={"Content-Type": "application/json"}, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=8) as res:
                body = json.loads(res.read().decode("utf-8"))
                for t in body.get("tasks", []):
                    print(f'TK-{t["task_no"]} [{t["status"]}] {t.get("assignee_name") or "未割当"}: {t["title"]}'
                          + (f'  ⛔{t["blocker"]}' if t.get("blocker") else ""))
                if not body.get("tasks"):
                    print("未完了タスクはありません")
        except Exception as e:
            print(f"ai-cockpit: 取得失敗: {e}", file=sys.stderr)
        return 0

    # 全リポジトリ監視: 直近3分以内に変更のあったリポジトリぶんhbを送る
    # （フック未導入の実行中セッションやVS Code等の作業も拾う「見える化の保険」）
    if cmd == "watch":
        WATCH_REPOS = ["ns-portal", "tori-dashboard", "nippo", "ns-daily-import", "NStyle-AI", "ns-info-system"]
        WINDOW = 180
        home = os.path.expanduser("~")
        me = os.path.abspath(__file__)
        def repo_active(path):
            newest = 0.0
            try:
                newest = os.path.getmtime(os.path.join(path, ".git", "index"))
            except OSError:
                pass
            try:
                out = subprocess.run(["git", "-C", path, "status", "--porcelain"],
                                     capture_output=True, text=True, timeout=10).stdout
                for line in out.splitlines()[:50]:
                    try:
                        newest = max(newest, os.path.getmtime(os.path.join(path, line[3:].strip())))
                    except OSError:
                        pass
            except Exception:
                pass
            return (time.time() - newest) < WINDOW
        cycle = 0
        while True:
            for name in WATCH_REPOS:
                rp = os.path.join(home, name)
                if not os.path.isdir(os.path.join(rp, ".git")):
                    continue
                try:
                    if repo_active(rp):
                        subprocess.run([sys.executable, me, "hb"], cwd=rp, timeout=30)
                except Exception:
                    pass
            # 定期ジョブ収集: 初回すぐ・以後は約10分おき（Mac miniマーカー＋GitHub Actions）
            if cycle % 20 == 0:
                try:
                    n = report_jobs(conf)
                    if n and "once" in flags:
                        print(f"job_runs {n}件送信")
                except Exception:
                    pass
            cycle += 1
            if "once" in flags:
                return 0
            time.sleep(30)

    g = git_info()
    agent = flags.get("agent") or os.environ.get("AI_COCKPIT_AGENT", "")
    session_key = conf["DEVICE_KEY"] + ":" + (agent or g.get("repository") or "session")

    # タスク登録
    if cmd == "add":
        if not flags.get("title"):
            print("--title を指定してください", file=sys.stderr)
            return 0
        payload = {"token": conf["TOKEN"], "agent_name": agent or g.get("repository", ""),
                   "create_task": {"title": flags["title"], "description": flags.get("desc", ""),
                                   "assignee_name": agent or "", "priority": flags.get("priority", "mid"),
                                   "status": flags.get("status", "backlog"),
                                   "on_done_note": flags.get("note", ""), "unblocks": flags.get("unblocks", ""),
                                   "repository": g.get("repository", "")}}
        req = urllib.request.Request(conf["INGEST_URL"], data=json.dumps(payload).encode("utf-8"),
                                     headers={"Content-Type": "application/json"}, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=8) as res:
                body = json.loads(res.read().decode("utf-8"))
                print("ai-cockpit: 登録OK " + str(body.get("task")))
        except Exception as e:
            print(f"ai-cockpit: 登録失敗: {e}", file=sys.stderr)
        return 0

    # hbは20秒間引き（セッション単位＝リポジトリ/担当ごとに別カウント）
    if cmd == "hb":
        tpath = THROTTLE_PATH + "_" + "".join(c for c in session_key if c.isalnum() or c in "-_")
        try:
            if time.time() - os.path.getmtime(tpath) < THROTTLE_SEC:
                return 0
        except OSError:
            pass
        try:
            os.makedirs(CONF_DIR, exist_ok=True)
            with open(tpath, "w") as f:
                f.write(str(time.time()))
        except OSError:
            pass

    payload = {
        "token": conf["TOKEN"],
        "device_key": conf["DEVICE_KEY"],
        "hostname": socket.gethostname(),
        "os": "macOS " + platform.mac_ver()[0] if sys.platform == "darwin" else platform.system(),
        "session_key": session_key,
        "agent_type": "claude_code",
        **g,
    }
    payload.update(CMDS[cmd])
    # 担当名未指定でもリポジトリ名で名乗る（自動フック経由でもLIVEカードに名前が出るように）
    payload["agent_name"] = agent or g.get("repository") or conf["DEVICE_KEY"]
    if flags.get("task"): payload["task_no"] = flags["task"]
    if flags.get("percent"):
        try: payload["progress_percent"] = max(0, min(100, int(flags["percent"])))
        except ValueError: pass
    if flags.get("message"):
        payload["message"] = flags["message"]
        if cmd == "blocked": payload["blocker"] = flags["message"]
    if cmd == "done": payload.setdefault("progress_percent", 100)
    if cmd == "update":  # 台帳整備用: ai-cockpit update --task TK-42 --to 担当B --status ready
        if flags.get("status"): payload["task_status"] = flags["status"]
        if flags.get("to"): payload["task_assignee"] = flags["to"]
    if cmd == "approval-request":
        payload["approval_title"] = flags.get("message", "承認をお願いします")
        payload["approval_kind"] = flags.get("kind", "other")
        payload["approval_detail"] = flags.get("detail", "")
    if cmd == "approval-status":
        payload["approval_check"] = "1"
        if not flags.get("task"):
            print("--task TK-xx を指定してください", file=sys.stderr)
            return 0

    req = urllib.request.Request(
        conf["INGEST_URL"],
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as res:
            body = json.loads(res.read().decode("utf-8"))
            if cmd == "approval-status":
                for a in body.get("approvals", []):
                    mark = {"approved": "✅承認済み", "rejected": "❌却下", "pending": "⏳待ち"}.get(a["status"], a["status"])
                    print(f'{mark}: {a["title"]}')
                if not body.get("approvals"):
                    print("承認依頼はありません")
            elif cmd != "hb":
                print("ai-cockpit: 送信OK " + json.dumps({k: body.get(k) for k in ("session", "task")}, ensure_ascii=False))
    except Exception as e:
        # 送信失敗で開発を止めない
        if cmd != "hb":
            print(f"ai-cockpit: 送信失敗（無視して続行）: {e}", file=sys.stderr)
    return 0

if __name__ == "__main__":
    sys.exit(main())
